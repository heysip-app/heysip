<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:HeySip.App.Shell"
             x:Class="HeySip.App.Shell.RemovalBar"
             x:DataType="shell:RemovalBannerViewModel">
    <!-- The "Removed ... Undo" bar. DataContext is the removal banner view model. -->
    <Border Classes="toast" IsVisible="{Binding IsVisible}">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
            <Button Classes="accent" Content="Undo" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo removal" />
            <Button Classes="subtle" Command="{Binding DismissCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
                <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
