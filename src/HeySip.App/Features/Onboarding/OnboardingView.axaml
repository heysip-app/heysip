<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:onboarding="using:HeySip.App.Features.Onboarding"
             xmlns:settings="using:HeySip.App.Features.Settings"
             xmlns:controls="using:HeySip.App.Shared.Controls"
             xmlns:comp="using:HeySip.App.Shared.Components"
             x:Class="HeySip.App.Features.Onboarding.OnboardingView"
             x:DataType="onboarding:OnboardingViewModel">
    <Grid Background="{DynamicResource HbOverlayBrush}">
        <comp:Card Width="460" Padding="28" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <controls:DripControl Width="48" Height="68" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to HeySip" Classes="eyebrow" />
                        <TextBlock Text="{Binding StepTitle}" Classes="h2" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <TextBox Text="{Binding Name}" PlaceholderText="Your name (optional)" MaxLength="24" IsVisible="{Binding IsNameStep}" />

                <StackPanel Spacing="8" IsVisible="{Binding IsIntervalStep}">
                    <ItemsControl ItemsSource="{Binding IntervalChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <Button Content="{Binding StringFormat='{}{0} min'}"
                                        Command="{Binding $parent[ItemsControl].((onboarding:OnboardingViewModel)DataContext).PickIntervalCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Interval, StringFormat='Every {0} minutes. You can change this anytime in Settings.'}" Classes="muted" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Characters}" IsVisible="{Binding IsCharacterStep}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:CharacterOptionViewModel">
                            <settings:CharacterPick PreviewWidth="64" Margin="0,0,10,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Content="Skip" Command="{Binding SkipCommand}" Classes="subtle" />
                    <Button Grid.Column="2" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Classes="accent" Command="{Binding NextCommand}"
                            Content="{Binding IsLastStep, Converter={x:Static onboarding:OnboardingView.NextLabel}}" />
                </Grid>
        </comp:Card>
    </Grid>
</UserControl>
