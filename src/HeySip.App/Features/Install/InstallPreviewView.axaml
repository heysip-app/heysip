<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:install="using:HeySip.App.Features.Install"
             xmlns:controls="using:HeySip.App.Shared.Controls"
             xmlns:comp="using:HeySip.App.Shared.Components"
             x:Class="HeySip.App.Features.Install.InstallPreviewView"
             x:DataType="install:InstallPreviewViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="install:PreviewTileViewModel">
            <StackPanel Spacing="4">
                <controls:DripControl Width="84" Height="118" Pose="{Binding Pose}" Pack="{Binding Pack}"
                                      Character="{Binding Character}" Outfit="{Binding Outfit}" IsAnimated="False" />
                <TextBlock Text="{Binding Caption}" Classes="muted" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="84" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Shown over the window when a pack file is opened: what it is, how it looks, and Install or Cancel. -->
    <Grid Background="{DynamicResource HbOverlayBrush}">
        <comp:Card Width="540" Padding="26" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Eyebrow}" Classes="eyebrow" />
                <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding IsPreview}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="TileTemplate" />
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A character's own accessories, each worn by it, and what else it works with. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasBundled}">
                <TextBlock Text="Comes with" Classes="eyebrow" HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding BundledTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="TileTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding MoreText}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Reassurance}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsPreview}" />
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding IsFailed}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CloseCommand}" IsVisible="{Binding IsPreview}" />
                <Button Classes="accent" Content="{Binding InstallLabel}" Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}" IsVisible="{Binding IsPreview}" />
                <Button Content="Not now" Command="{Binding CloseCommand}" IsVisible="{Binding IsDone}" />
                <Button Classes="accent" Content="{Binding UseLabel}" Command="{Binding UseNowCommand}" IsVisible="{Binding IsDone}" />
                <Button Classes="accent" Content="Close" Command="{Binding CloseCommand}" IsVisible="{Binding IsFailed}" />
            </StackPanel>
        </comp:Card>
    </Grid>
</UserControl>
