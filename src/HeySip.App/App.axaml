<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HeySip.App.App"
             Name="HeySip"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HeySip/Shared/Styles/Theme.axaml" />
                <ResourceInclude Source="avares://HeySip/Shared/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A slightly denser type scale than Fluent's default, closer to an IDE. -->
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- RegionColor tints Fluent's own controls (text boxes, combo boxes) to sit on the Tidepool panels. -->
                <ColorPaletteResources x:Key="Light" Accent="#1F8A80" RegionColor="#FFFFFF" />
                <ColorPaletteResources x:Key="Dark" Accent="#4DB6AC" RegionColor="#2B2D30" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://HeySip/Shared/Styles/Controls.axaml" />
        <StyleInclude Source="avares://HeySip/Shared/Components/Components.axaml" />
    </Application.Styles>
</Application>
