<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tidepool: Rider-style neutral grays with a quiet teal accent, an icon rail and a status bar.
        Layers, back to front: Window (the frame and the page) -> Card (raised content). Surface is the lift used inside a card.
        Features reference these tokens, never raw colors.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HbWindowBrush" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="HbRailBrush" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="HbPanelBrush" Color="{DynamicResource HbGray18}" />
            <SolidColorBrush x:Key="HbSurfaceBrush" Color="{DynamicResource HbGray21}" />
            <SolidColorBrush x:Key="HbStatusBarBrush" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="HbBorderBrush" Color="{DynamicResource HbGray24}" />
            <SolidColorBrush x:Key="HbHoverBrush" Color="{DynamicResource HbGray100A07}" />
            <SolidColorBrush x:Key="HbClearBrush" Color="{DynamicResource HbGray100A00}" />
            <SolidColorBrush x:Key="HbAccentClearBrush" Color="{DynamicResource HbTeal51A00}" />
            <SolidColorBrush x:Key="HbPressedBrush" Color="{DynamicResource HbGray100A11}" />
            <SolidColorBrush x:Key="HbTextBrush" Color="{DynamicResource HbGray89}" />
            <SolidColorBrush x:Key="HbTextSecondaryBrush" Color="{DynamicResource HbGray70}" />
            <SolidColorBrush x:Key="HbTextMutedBrush" Color="{DynamicResource HbGray52}" />
            <SolidColorBrush x:Key="HbAccentBrush" Color="{DynamicResource HbTeal51}" />
            <SolidColorBrush x:Key="HbAccentSoftBrush" Color="{DynamicResource HbTeal51A16}" />
            <SolidColorBrush x:Key="HbOnAccentBrush" Color="{DynamicResource HbTeal10}" />
            <SolidColorBrush x:Key="HbSuccessBrush" Color="{DynamicResource HbGreen63}" />
            <SolidColorBrush x:Key="HbWarningBrush" Color="{DynamicResource HbAmber63}" />
            <SolidColorBrush x:Key="HbDangerBrush" Color="{DynamicResource HbRed67}" />
            <SolidColorBrush x:Key="HbBarBrush" Color="{DynamicResource HbTeal42}" />
            <x:Double x:Key="HbOverlayOpacity">0.55</x:Double>
            <SolidColorBrush x:Key="HbOverlayBrush" Color="{DynamicResource HbGray0}" Opacity="{DynamicResource HbOverlayOpacity}" />

            <!-- Fluent's own control brushes, in the same neutral grays. -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource HbGray32}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource HbGray46}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource HbGray32}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource HbGray46}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource HbGray24}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource HbGray28}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource HbGray32}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource HbGray32}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource HbGray39}" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource HbGray28}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocusedPressed" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource HbGray46}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource HbGray18}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HbWindowBrush" Color="{DynamicResource HbGray93}" />
            <SolidColorBrush x:Key="HbRailBrush" Color="{DynamicResource HbGray93}" />
            <SolidColorBrush x:Key="HbPanelBrush" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="HbSurfaceBrush" Color="{DynamicResource HbGray97}" />
            <SolidColorBrush x:Key="HbStatusBarBrush" Color="{DynamicResource HbGray93}" />
            <SolidColorBrush x:Key="HbBorderBrush" Color="{DynamicResource HbGray89}" />
            <SolidColorBrush x:Key="HbHoverBrush" Color="{DynamicResource HbGray0A06}" />
            <SolidColorBrush x:Key="HbClearBrush" Color="{DynamicResource HbGray0A00}" />
            <SolidColorBrush x:Key="HbAccentClearBrush" Color="{DynamicResource HbTeal33A00}" />
            <SolidColorBrush x:Key="HbPressedBrush" Color="{DynamicResource HbGray0A10}" />
            <SolidColorBrush x:Key="HbTextBrush" Color="{DynamicResource HbGray13}" />
            <SolidColorBrush x:Key="HbTextSecondaryBrush" Color="{DynamicResource HbGray36}" />
            <SolidColorBrush x:Key="HbTextMutedBrush" Color="{DynamicResource HbGray50}" />
            <SolidColorBrush x:Key="HbAccentBrush" Color="{DynamicResource HbTeal33}" />
            <SolidColorBrush x:Key="HbAccentSoftBrush" Color="{DynamicResource HbTeal33A14}" />
            <SolidColorBrush x:Key="HbOnAccentBrush" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="HbSuccessBrush" Color="{DynamicResource HbGreen36}" />
            <SolidColorBrush x:Key="HbWarningBrush" Color="{DynamicResource HbAmber30}" />
            <SolidColorBrush x:Key="HbDangerBrush" Color="{DynamicResource HbRed46}" />
            <SolidColorBrush x:Key="HbBarBrush" Color="{DynamicResource HbTeal59}" />
            <x:Double x:Key="HbOverlayOpacity">0.35</x:Double>
            <SolidColorBrush x:Key="HbOverlayBrush" Color="{DynamicResource HbGray0}" Opacity="{DynamicResource HbOverlayOpacity}" />

            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource HbGray81}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource HbGray68}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource HbGray81}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource HbGray68}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource HbGray94}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource HbGray91}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource HbGray87}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource HbGray89}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource HbGray81}" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource HbGray90}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocusedPressed" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource HbGray100}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource HbGray68}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource HbGray100}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shape and type tokens, shared by both themes. -->
    <CornerRadius x:Key="HbPanelRadius">12</CornerRadius>
    <CornerRadius x:Key="HbCardRadius">10</CornerRadius>
    <CornerRadius x:Key="HbControlRadius">8</CornerRadius>
    <x:Double x:Key="HbBodyFontSize">13</x:Double>
    <x:Double x:Key="HbStatusFontSize">12</x:Double>
    <FontFamily x:Key="HbMonoFont">Cascadia Mono, Cascadia Code, Consolas, Menlo, monospace</FontFamily>
</ResourceDictionary>
