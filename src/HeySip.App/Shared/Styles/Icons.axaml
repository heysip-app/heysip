    <StreamGeometry x:Key="IconChart">M4,20 V11 H8 V20 Z M10,20 V4 H14 V20 Z M16,20 V8 H20 V20 Z</StreamGeometry>
    <!-- Even-odd fill (F0) so each knob is a ring, with the line broken around it. -->
    <StreamGeometry x:Key="IconSliders">F0 M3,5.5 H5.3 V7.5 H3 Z M10.7,5.5 H21 V7.5 H10.7 Z M8,3.8 A2.7,2.7 0 1 0 8,9.2 A2.7,2.7 0 1 0 8,3.8 Z M8,5.3 A1.2,1.2 0 1 1 8,7.7 A1.2,1.2 0 1 1 8,5.3 Z M3,11 H13.3 V13 H3 Z M18.7,11 H21 V13 H18.7 Z M16,9.3 A2.7,2.7 0 1 0 16,14.7 A2.7,2.7 0 1 0 16,9.3 Z M16,10.8 A1.2,1.2 0 1 1 16,13.2 A1.2,1.2 0 1 1 16,10.8 Z M3,16.5 H7.3 V18.5 H3 Z M12.7,16.5 H21 V18.5 H12.7 Z M10,14.8 A2.7,2.7 0 1 0 10,20.2 A2.7,2.7 0 1 0 10,14.8 Z M10,16.3 A1.2,1.2 0 1 1 10,18.7 A1.2,1.2 0 1 1 10,16.3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M8,5 L16,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M5,8 L12,16 L19,8 Z</StreamGeometry>
