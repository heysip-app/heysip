<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 24x24 filled glyphs for PathIcon, so they take the Foreground of whatever hosts them. -->
    <StreamGeometry x:Key="IconDrop">M12,2.5 C12,2.5 5,10.2 5,15 A7,7 0 0 0 19,15 C19,10.2 12,2.5 12,2.5 Z</StreamGeometry>
