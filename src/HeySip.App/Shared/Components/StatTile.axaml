<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:HeySip.App.Shared.Components"
             x:Class="HeySip.App.Shared.Components.StatTile"
             x:Name="Root"
             x:DataType="comp:StatTile">
    <comp:Card Spacing="4">
        <TextBlock Text="{Binding #Root.Label}" Classes="eyebrow" />
        <TextBlock Text="{Binding #Root.Value}" Classes="stat" />
    </comp:Card>
</UserControl>
